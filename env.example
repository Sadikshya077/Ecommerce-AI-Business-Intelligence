# Copy this file to .env and fill in your local PostgreSQL settings.
# .env is gitignored -- never commit real credentials.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_bi

# Shared-secret key required in the X-API-Key header for all FastAPI
# endpoints except /health. Generate a real random value for your local .env -- never commit the actual key.
API_KEY=changeme-generate-a-random-value

# Comma-separated list of origins allowed to call the API via CORS.
# Defaults to the Streamlit dashboard's local dev port if unset.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

GEMINI_API_KEY=your_actual_gemini_key_here
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
