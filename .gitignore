# --- Secrets ---
.env

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# --- Data (raw + processed are regenerated by the ETL pipeline, not hand-authored) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- MLflow run artifacts (regenerated by training scripts) ---
mlflow/
mlruns/
mlartifacts/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Model artifacts (large binary files -- track via MLflow, not git) ---
*.pkl
*.joblib
models/**/*.bin

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Test / coverage ---
.pytest_cache/
.coverage
htmlcov/